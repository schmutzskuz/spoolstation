{
  "name": "spoolstation-desktop",
  "version": "1.0.0",
  "description": "SpoolStation – PC-Programm fuer NFC-Tags, Spoolman und Snapmaker U1",
  "author": "Florian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/schmutzskuz/spoolstation.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "help:shots": "node scripts/help-shots.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "bonjour-service": "^1.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "esptool-js": "^0.5.4",
    "i18next": "^23.16.8",
    "react-i18next": "^15.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.454.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
